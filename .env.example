# ===== SERVER =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/hospital_erp

# Auth secrets (use long random values in production)
JWT_SECRET=change_me_access_token_secret
JWT_REFRESH_SECRET=change_me_refresh_token_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# File storage provider: local | s3 | cloudinary
UPLOAD_PROVIDER=local
MAX_FILE_SIZE_MB=10

# AWS (only used when UPLOAD_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=

# Cloudinary (only used when UPLOAD_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP) - future mail/notification features
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Hospital ERP <noreply@hospital.local>"

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300

# Seed
SEED_ADMIN_EMAIL=superadmin@hospital.com
SEED_ADMIN_PASSWORD=Admin@123

# ===== CLIENT =====
VITE_API_URL=http://localhost:5000/api
VITE_CLIENT_URL=http://localhost:5173