# --- Frontend deploy (Netlify) -------------------------------------------
# Set BOTH variables in Netlify: Site settings > Environment variables.
# They are needed because Netlify serves only the static React build; the
# Express API + Socket.IO server must be hosted elsewhere.

# Origin of the Express API, including the /api prefix.
# e.g. https://erp-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Socket.IO connects to the API origin, not to the Netlify site.
# Defaults to the origin of VITE_API_URL when unset, so usually leave blank.
# VITE_SOCKET_URL=https://erp-api.onrender.com

# --- Backend env vars (set on the API host, NOT here) ---------------------
# MONGO_URI, JWT_SECRET, JWT_REFRESH_SECRET, CLIENT_URL, UPLOAD_PROVIDER,
# SMTP_*, SEED_ADMIN_EMAIL, SEED_ADMIN_PASSWORD

# NOTE: never commit a real .env. Only .env.example is tracked in git.
# Locally the Vite dev server proxies /api -> http://localhost:5000
# (see vite.config.js), so these can stay unset while developing.
