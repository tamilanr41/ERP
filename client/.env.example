# Local dev: leave VITE_API_URL unset (or set to localhost:5000/api).
# The Vite dev server proxies /api -> http://localhost:5000 (see vite.config.js).

# Netlify: set this in the site's build environment (Site settings > Environment
# variables) to the deployed backend origin. Netlify hosts ONLY the React
# frontend - the Express API must run on Render/Railway/Fly.io/a VPS.
VITE_API_URL=http://localhost:5000/api
